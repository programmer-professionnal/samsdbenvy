{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "target": "sams",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "**",
        "destination": "https://programmer-professionnal.github.io/samsdbenvy/",
        "type": 302
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "SAMS Envy RP",
        "supportEmail": "xautumx7@gmail.com",
        "authorizedRedirectUris": [
          "https://samsdbenvy.web.app",
          "https://samsdbenvy.web.app/",
          "https://samsdbenvy.web.app/__/auth/handler"
        ]
      }
    }
  }
}
